{
  "schemaVersion": "1.0.0",
  "scope": "Isolated analytical fixtures; all coefficients and RIRs are synthetic or derived, never measured",
  "coordinateSystem": "right-handed, Y-up, meters",
  "surfaces": {
    "floor": {
      "id": "floor",
      "point": [0, 0, 0],
      "normal": [0, 1, 0],
      "vertices": [
        [-10, 0, -10],
        [-10, 0, 10],
        [10, 0, 10],
        [10, 0, -10]
      ]
    },
    "wall": {
      "id": "wall",
      "point": [0, 0, 0],
      "normal": [1, 0, 0],
      "vertices": [
        [0, 0, -10],
        [0, 10, -10],
        [0, 10, 10],
        [0, 0, 10]
      ]
    },
    "blocker": {
      "id": "blocker",
      "point": [2, 0, 0],
      "normal": [1, 0, 0],
      "vertices": [
        [2, 0, -1],
        [2, 2, -1],
        [2, 2, 1],
        [2, 0, 1]
      ]
    }
  },
  "fixtures": [
    {
      "id": "free-field-3-4-5",
      "kind": "direct",
      "evidenceType": "DERIVED",
      "input": { "source": [0, 0, 0], "receiver": [3, 4, 0], "c": 343 },
      "units": {
        "position": "m",
        "c": "m/s",
        "delay": "s",
        "pressureRatio": "dimensionless, reference 1m"
      },
      "expected": { "distance": 5, "delaySeconds": 0.014577259475218658, "pressureRatio": 0.2 },
      "referenceClaimIds": ["ACO-001"],
      "tolerance": {
        "absolute": 1e-12,
        "explanation": "double precision algebra only; excludes calibrated SPL"
      },
      "reproduction": "npm test"
    },
    {
      "id": "finite-first-reflection",
      "kind": "reflection",
      "evidenceType": "DERIVED",
      "input": { "source": [1, 1, 0], "receiver": [5, 1, 0], "surfaces": ["floor"] },
      "units": { "position": "m", "distance": "m" },
      "expected": { "hits": [[3, 0, 0]], "distance": 4.47213595499958 },
      "referenceClaimIds": ["ACO-002"],
      "tolerance": {
        "absolute": 1e-10,
        "explanation": "image point (- equivalent floor mirror), analytic sqrt20"
      },
      "reproduction": "npm test"
    },
    {
      "id": "finite-second-reflection",
