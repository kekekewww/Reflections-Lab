  "method": "Exact reviewed byte snapshots are pinned; after removal of generated notices/anchors, final bodies must equal the reviewed bodies with only verified local-link mapping and the notice formatter's frontmatter-separator whitespace normalization applied. All provenance metadata is unchanged except links=english-relative.",
  "comparison_setup_note": "Initial stricter comparison found one extra blank line after log frontmatter in the reviewed snapshot. The existing notice formatter normalizes that separator; this comparison explicitly models it without changing any document or wording.",
  "reproduction_script": "import fs from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {parseTranslation,rewriteLinks} from '../../../scripts/validation/english-docs.mjs';\nconst base='.cache/v1/english-final-refresh',hash=bytes=>createHash('sha256').update(bytes).digest('hex');\nconst before=JSON.parse(fs.readFileSync(`${base}/reviewed-targets.json`)),manifest=JSON.parse(fs.readFileSync('docs/en/manifest.json'));\nconst mapping=new Map(manifest.entries.map(entry=>[entry.source,entry.target]));\nconst clean=body=>body.replace(/<!-- english-notice:start -->[\\s\\S]*?<!-- english-notice:end -->\\r?\\n(?:\\r?\\n)?/g,'').replace(/<!-- english-original-anchor -->\\s*<a id=\"[^\"]*\"><\\/a>\\r?\\n?/g,'');\nconst noticeBoundary=body=>{const frontmatter=body.match(/^---\\r?\\n[\\s\\S]*?\\r?\\n---\\r?\\n/);return frontmatter?frontmatter[0]+'\\n'+body.slice(frontmatter[0].length).replace(/^\\s*\\n/,''):body;};\nconst rows=before.entries.map(entry=>{\n const originalBytes=fs.readFileSync(entry.reviewed_snapshot),currentBytes=fs.readFileSync(entry.target),pre=parseTranslation(originalBytes.toString('utf8')),post=parseTranslation(currentBytes.toString('utf8'));\n if(hash(originalBytes)!==entry.reviewed_target_sha256||hash(fs.readFileSync(entry.source))!==entry.source_sha256)throw Error(`Review/source pin changed: ${entry.source}`);\n const mapped=rewriteLinks(clean(pre.body),entry.source,entry.target,mapping,pre.metadata.links==='english-relative');\n const expected=noticeBoundary(mapped);\n const metadataExpected={...pre.metadata,links:'english-relative'};\n if(clean(post.body)!==expected||JSON.stringify(post.metadata)!==JSON.stringify(metadataExpected))throw Error(`Nonmechanical difference after review: ${entry.source}`);\n return{...entry,final_target_sha256:hash(currentBytes),reviewed_body_preserved_except_verified_navigation_notice_anchors:true,frontmatter_notice_boundary_whitespace_normalized:expected!==mapped,source_sha256_current:true};\n});\nconst oldRaw=JSON.parse(fs.readFileSync('.cache/v1/english-frozen-history-prep/manifest-before-frozen-promotion.json')).excluded_shared_raw;\nconst pinPlan=JSON.parse(fs.readFileSync('.cache/v1/english-frozen-history-prep/raw-snapshot-plan.json'));\nconst currentRaw=new Map(manifest.excluded_shared_raw.map(entry=>[entry.source,entry]));\nfor(const record of oldRaw)if(JSON.stringify(currentRaw.get(record.source))!==JSON.stringify(record))throw Error('Original five raw exclusions changed');\nfor(const record of pinPlan.new_exact_copies){const current=currentRaw.get(record.source);if(!current||current.source_sha256!==record.source_sha256||current.evidence.sha256!==record.evidence.sha256||current.evidence.path!==record.evidence.path)throw Error('Prepared raw receipt changed');}\nconst guide=before.authored_english_guide;\nif(hash(fs.readFileSync(guide.path))!==guide.sha256)throw Error('Reviewed authored guide changed');\nconst report={generated_at:new Date().toISOString(),status:'PASS_CHANGED_PROSE_MECHANICAL_FINALIZATION',scope:'22 independently reviewed changed source/translation pairs plus one independently reviewed authored English guide. This does not newly semantically review unchanged historical pages or validate product behavior.',entries:rows,reviews:before.reviews,authored_english_guide:guide,raw_exclusions:{count:currentRaw.size,original_five_records_unchanged:true,new_three_exact_receipt_pins_unchanged:true},method:'Exact reviewed byte snapshots are pinned; after removal of generated notices/anchors, final bodies must equal the reviewed bodies with only verified local-link mapping and the notice formatter\\'s frontmatter-separator whitespace normalization applied. All provenance metadata is unchanged except links=english-relative.',comparison_setup_note:'Initial stricter comparison found one extra blank line after log frontmatter in the reviewed snapshot. The existing notice formatter normalizes that separator; this comparison explicitly models it without changing any document or wording.',reproduction_script:fs.readFileSync(`${base}/mechanical-proof.mjs`,'utf8')};\nconst file=`docs/en/_reports/final-refresh-mechanical-${report.generated_at.replace(/[-:.]/g,'')}.json`;fs.writeFileSync(file,JSON.stringify(report,null,2)+'\\n',{flag:'wx'});\nconsole.log(JSON.stringify({file,sha256:hash(fs.readFileSync(file)),pairs:rows.length,raw:currentRaw.size,guide_unchanged:true,status:report.status}));\n"
