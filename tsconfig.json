{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "tests/contracts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "benchmarks/muse-limits/**/*.ts",
    "schemas/sound-behavior/**/*.ts",
    "vite.config.ts",
    "vite.site.config.ts"
  ]
}
