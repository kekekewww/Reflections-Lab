{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflection-lab.local/schemas/material.schema.json",
  "title": "Reflection Lab Acoustic Material v1",
  "description": "A/R/T are energy fractions at equal reference conditions. Domain validation checks sum=1 and ordered band centers.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "label", "dataClass", "sourceUrls", "conditions", "phaseModel", "bands"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 0}, "label": {"type": "string", "minLength": 1, "maxLength": 160},
    "dataClass": {"enum": ["Measured", "Derived", "Tuned", "Synthetic"]},
    "sourceUrls": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^https://", "maxLength": 2048}},
    "conditions": {"type": "string", "minLength": 1, "maxLength": 2048}, "phaseModel": {"const": "zeroPhaseMagnitudeOnly"},
    "bands": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["centerHz", "absorptionEnergy", "reflectionEnergy", "transmissionEnergy", "scatteringFraction"], "properties": {"centerHz": {"type": "number", "minimum": 20, "maximum": 24000}, "absorptionEnergy": {"$ref": "#/$defs/fraction"}, "reflectionEnergy": {"$ref": "#/$defs/fraction"}, "transmissionEnergy": {"$ref": "#/$defs/fraction"}, "scatteringFraction": {"$ref": "#/$defs/fraction"}}}}
  },
  "$defs": {"fraction": {"type": "number", "minimum": 0, "maximum": 1}}
}
