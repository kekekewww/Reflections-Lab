{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflection-lab.local/schemas/wiki-page.schema.json",
  "title": "Wiki page metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "status",
    "created_at",
    "updated_at",
    "sources",
    "related_tasks",
    "related_decisions",
    "supersedes",
    "tags"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "index",
        "state",
        "goals",
        "roadmap",
        "tasks",
        "architecture",
        "decision",
        "feature",
        "research",
        "design",
        "experiment",
        "history",
        "blocker",
        "concept",
        "handoff",
        "log"
      ]
    },
    "status": {
      "enum": ["VERIFIED", "ACCEPTED", "PROPOSED", "EXPERIMENTAL", "UNVERIFIED", "DEPRECATED"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "related_tasks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "related_decisions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "superseded_by": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "$ref": "wiki-task.schema.json#/$defs/evidence" } },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value", "status", "evidence"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": {},
          "status": {
            "enum": ["VERIFIED", "ACCEPTED", "PROPOSED", "EXPERIMENTAL", "UNVERIFIED", "DEPRECATED"]
          },
          "evidence": {
            "type": "array",
            "items": { "$ref": "wiki-task.schema.json#/$defs/evidence" }
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
