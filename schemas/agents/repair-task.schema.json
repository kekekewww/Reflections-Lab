{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflection-lab.local/schemas/agents/repair-task.schema.json",
  "title": "Bounded repair request linked to original acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "repair_round",
    "defects",
    "allowed_files",
    "remaining_work"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repair_round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptance_id", "expected", "actual", "evidence"],
        "additionalProperties": false,
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "object",
            "required": ["id", "path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
              },
              "authority": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "allowed_files": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_@. -]+(?:/[A-Za-z0-9_@. -]+)*$"
      },
      "default": []
    },
    "remaining_work": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      },
      "default": []
    }
  }
}
