{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflection-lab.local/schemas/scene.schema.json",
  "title": "Reflection Lab Scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sceneId",
    "sceneRevision",
    "units",
    "coordinateSystem",
    "seed",
    "gravityMps2",
    "objects",
    "sources",
    "listener"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sceneId": {
      "$ref": "#/$defs/id"
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0
    },
    "units": {
      "const": "SI"
    },
    "coordinateSystem": {
      "const": "right-handed-y-up-minus-z-forward"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "gravityMps2": {
      "$ref": "#/$defs/vector"
    },
    "objects": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "listener": {
      "$ref": "#/$defs/listener"
    },
    "zones": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/zone"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -200,
        "maximum": 200
      }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shape",
        "dimensionsM",
        "positionM",
        "orientationQuaternion",
        "mode",
        "massKg",
        "friction",
        "restitution",
        "physicsMaterialId",
        "acousticMaterialId",
        "acousticRole"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "shape": {
          "enum": ["box", "sphere", "capsule"]
        },
        "dimensionsM": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 100
          }
        },
        "positionM": {
          "$ref": "#/$defs/vector"
        },
        "orientationQuaternion": {
          "$ref": "#/$defs/quaternion"
        },
        "mode": {
          "enum": ["dynamicGravity", "dynamicNoGravity", "fixed", "kinematic"]
        },
        "massKg": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 10000
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "physicsMaterialId": {
          "$ref": "#/$defs/id"
        },
        "acousticMaterialId": {
          "$ref": "#/$defs/id"
        },
        "acousticRole": {
          "enum": ["none", "staticSurface", "dynamicOccluder", "dynamicReflector"]
        },
        "trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offsetsM", "strengthMps", "startDelayS", "faceAlongPath"],
          "properties": {
            "offsetsM": {
              "type": "array",
              "minItems": 1,
              "maxItems": 63,
              "items": {
                "$ref": "#/$defs/vector"
              }
            },
            "strengthMps": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 20
            },
            "startDelayS": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "faceAlongPath": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectId", "signalId", "mode", "gainDbfs", "playing"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "signalId": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": ["continuous", "impact"]
        },
        "gainDbfs": {
          "type": "number",
          "minimum": -80,
          "maximum": -6
        },
        "playing": {
          "type": "boolean"
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "positionM", "orientationQuaternion", "attachment"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "positionM": {
          "$ref": "#/$defs/vector"
        },
        "orientationQuaternion": {
          "$ref": "#/$defs/quaternion"
        },
        "attachment": {
          "enum": ["independent", "fpsHead"]
        }
      }
    },
    "zone": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "enabled", "centerM", "hysteresisM", "shape", "halfExtentsM"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "enabled": {
              "type": "boolean"
            },
            "centerM": {
              "$ref": "#/$defs/vector"
            },
            "hysteresisM": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "shape": {
              "const": "aabb"
            },
            "halfExtentsM": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 50
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "enabled", "centerM", "hysteresisM", "shape", "radiusM"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "enabled": {
              "type": "boolean"
            },
            "centerM": {
              "$ref": "#/$defs/vector"
            },
            "hysteresisM": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "shape": {
              "const": "sphere"
            },
            "radiusM": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 50
            }
          }
        }
      ]
    }
  }
}
