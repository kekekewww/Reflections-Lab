{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflection-lab.local/schemas/scene.schema.json",
  "title": "Reflection Lab Scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "sceneRevision", "units", "coordinateSystem", "seed", "gravityMps2", "objects", "sources", "listener"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sceneId": {"$ref": "#/$defs/id"},
    "sceneRevision": {"type": "integer", "minimum": 0},
    "units": {"const": "SI"},
    "coordinateSystem": {"const": "right-handed-y-up-minus-z-forward"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "gravityMps2": {"$ref": "#/$defs/vector"},
    "objects": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/object"}},
    "sources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/source"}},
    "listener": {"$ref": "#/$defs/listener"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -200, "maximum": 200}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "shape", "dimensionsM", "positionM", "orientationQuaternion", "mode", "massKg", "friction", "restitution", "physicsMaterialId", "acousticMaterialId", "acousticRole"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "shape": {"enum": ["box", "sphere", "capsule"]},
        "dimensionsM": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.01, "maximum": 100}},
        "positionM": {"$ref": "#/$defs/vector"}, "orientationQuaternion": {"$ref": "#/$defs/quaternion"},
        "mode": {"enum": ["dynamicGravity", "dynamicNoGravity", "fixed", "kinematic"]},
        "massKg": {"type": "number", "minimum": 0.001, "maximum": 10000},
        "friction": {"type": "number", "minimum": 0, "maximum": 2}, "restitution": {"type": "number", "minimum": 0, "maximum": 1},
        "physicsMaterialId": {"$ref": "#/$defs/id"}, "acousticMaterialId": {"$ref": "#/$defs/id"},
        "acousticRole": {"enum": ["none", "staticSurface", "dynamicOccluder", "dynamicReflector"]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objectId", "signalId", "mode", "gainDbfs", "playing"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "objectId": {"$ref": "#/$defs/id"}, "signalId": {"$ref": "#/$defs/id"}, "mode": {"enum": ["continuous", "impact"]}, "gainDbfs": {"type": "number", "minimum": -80, "maximum": -6}, "playing": {"type": "boolean"}}
    },
    "listener": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "positionM", "orientationQuaternion", "attachment"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "positionM": {"$ref": "#/$defs/vector"}, "orientationQuaternion": {"$ref": "#/$defs/quaternion"}, "attachment": {"enum": ["independent", "fpsHead"]}}
    }
  }
}
